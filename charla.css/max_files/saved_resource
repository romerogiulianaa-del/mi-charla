const safeListener = (type, attribute, getTargets, getData) => {
    return (onEvent) => {
        const targets = getTargets();

        targets.forEach((target) => {
            // If can't find element, skip
            if (!target) return;

            const hasListener = Boolean(target?.getAttribute(attribute));

            if (target && !hasListener) {
                target.addEventListener(type, (event) => {

                    // Run callback function to get product data
                    const data = getData(event, target);
                    onEvent(data);
                }, true);

                // Set attribute as well as event listener
                // If attribute disappears, event listener has probably disappeared
                target.setAttribute(attribute, "true");
            }
        });
    };
};
