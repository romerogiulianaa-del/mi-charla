$smcT5.CustomScripts.SecondSessionDynamicBasketReady = function () {
    const basket = $smcT5.tagHelpers.basket.getBasket();
    const sessionCount = Number(localStorage.getItem('smc_sesn_count') || 0);

    const currentItem = basket && basket.length ? basket[basket.length - 1] : null;
    const nextSesnItem = $smcT5.CookieManager.read('smc_dyn_second');
    const nextItemParsed = nextSesnItem 
        ? JSON.parse(decodeURIComponent(atob(nextSesnItem))) 
        : null;

    const shouldUpdateCookie = currentItem && 
        (!nextSesnItem || (nextItemParsed && sessionCount && Number(nextItemParsed.session) === sessionCount));

    if (shouldUpdateCookie && currentItem) {

        // Set cookie for 2 days (60 minutes * 24 hours * 2 days)
        const itemEncoded = btoa(encodeURIComponent(JSON.stringify(currentItem)));
        $smcT5.CookieManager.create('smc_dyn_second', itemEncoded, 60 * 24 * 2);
    }

    return nextItemParsed ? Number(nextItemParsed.session) < sessionCount : false;
};

